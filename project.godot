; Engine configuration file.
config_version=5

[application]
config/name="I've Hung You From the Moon"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]
Events="*res://autoload/events.gd"
Game="*res://autoload/game.gd"
Unreality="*res://autoload/unreality.gd"
Acts="*res://autoload/acts.gd"
SaveGame="*res://autoload/save_game.gd"
DebugMenu="*res://autoload/debug_menu.gd"
Dialogue="*res://scenes/dialogue/dialogue.gd"
PostFX="*res://scenes/fx/post_fx.gd"
Cutscene="*res://scenes/cutscene/cutscene.gd"
PauseMenu="*res://scenes/menus/pause_menu.gd"
Audio="*res://scenes/audio/audio.gd"
Music="*res://scenes/audio/music.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]
renderer/rendering_method="forward_plus"
rendering/anti_aliasing/quality/msaa_3d=2
rendering/anti_aliasing/quality/screen_space_aa=1
rendering/lights_and_shadows/directional_shadow/size=4096
rendering/lights_and_shadows/positional_shadow/atlas_size=4096
rendering/lights_and_shadows/positional_shadow/atlas_subdiv=2
rendering/environment/ssao/quality=2
rendering/environment/ssao/half_size=true
rendering/environment/glow/upscale_mode=1
rendering/environment/glow/quality=1

[shader_globals]

unreality={
"type": "float",
"value": 0.0
}
unreal_time={
"type": "float",
"value": 0.0
}
